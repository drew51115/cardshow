# CardShow — Environment Variables
# Copy to .env.local for local Netlify dev (netlify dev command).
# Set real values in Netlify dashboard → Site settings → Environment variables.

# PSA API — cert lookup for PSA-graded slabs
# Obtain from https://api.psacard.com (requires PSA collector account)
PSA_API_TOKEN=your_psa_api_token_here

# CGC API — cert lookup for CGC-graded cards
# Obtain from https://api.cgccomics.com (requires CGC account)
CGC_API_TOKEN=your_cgc_api_token_here

# PriceCharting subscription token — pricecharting.com/pricecharting-pro
# Subscription starts at $4.99/month. Token found at:
# pricecharting.com → Account → Subscription → API/Download button
# Used for sports card comp lookups via the sportscardspro.com /api/product endpoint
# Rate limit: 1 call per second — enforced server-side + 1200ms client-side delay
PRICECHARTING_TOKEN=

# TCG API key — tcgapi.dev
# Free tier: 100 requests/day. Pro: $49.99/month for 10K/day
# Used for Pokemon, MTG, Yu-Gi-Oh, Lorcana, and 85+ TCG games
TCG_API_KEY=

# Supabase service role key (server-side only — never in client code)
# Used by comp-lookup.js to read/write the price_cache table
SUPABASE_SERVICE_KEY=

# Anthropic API — Sprint 2 vision card identification (vision-scan.js)
# Obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Trading Card API — Sprint 3 live card database autocomplete
# Apply for early access at https://tradingcardapi.com/early-access
# Without this key the autocomplete falls back to the local 60-card CARD_DB —
# all Sprint 3 UI works but shows the local list instead of 3M+ cards.
# Add in Netlify dashboard → Site settings → Environment variables
TRADING_CARD_API_KEY=

# TCGapis.com — reserved; superseded by TCG_API_KEY above for comp pricing
TCGAPIS_KEY=

# Search cache invalidation secret — protects /.netlify/functions/invalidate-search-cache
# Set to a random string (e.g. openssl rand -hex 24). Pass as x-invalidate-secret header.
CACHE_INVALIDATE_SECRET=
